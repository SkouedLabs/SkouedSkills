# /etc/systemd/system/nft-blocklist-update.service

[Unit]
Description=Refresh nftables blocklist from threat feeds
Wants=network-online.target
After=network-online.target nft-blocklist.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nft-blocklist-update
StateDirectory=nft-blocklist
StateDirectoryMode=0750

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
